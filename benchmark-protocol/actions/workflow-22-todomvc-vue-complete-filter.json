{
  "actions": [
    {
      "at_seconds": 1,
      "expected_outcome": "success",
      "expected_result": "the input contains active item",
      "id": "add-active",
      "locator": {
        "by": "css",
        "value": ".new-todo"
      },
      "required": true,
      "type": "fill",
      "value": "active item"
    },
    {
      "at_seconds": 2,
      "expected_outcome": "success",
      "expected_result": "active item appears",
      "id": "commit-active",
      "key": "Enter",
      "locator": {
        "by": "css",
        "value": ".new-todo"
      },
      "required": true,
      "type": "press"
    },
    {
      "at_seconds": 3,
      "expected_outcome": "success",
      "expected_result": "the input contains completed item",
      "id": "add-completed",
      "locator": {
        "by": "css",
        "value": ".new-todo"
      },
      "required": true,
      "type": "fill",
      "value": "completed item"
    },
    {
      "at_seconds": 4,
      "expected_outcome": "success",
      "expected_result": "completed item appears",
      "id": "commit-completed",
      "key": "Enter",
      "locator": {
        "by": "css",
        "value": ".new-todo"
      },
      "required": true,
      "type": "press"
    },
    {
      "at_seconds": 5,
      "expected_outcome": "success",
      "expected_result": "the second item becomes completed",
      "id": "complete-second",
      "locator": {
        "by": "css",
        "value": ".todo-list li:nth-child(2) .toggle"
      },
      "required": true,
      "type": "check"
    },
    {
      "at_seconds": 7,
      "expected_outcome": "success",
      "expected_result": "only completed items are shown",
      "id": "show-completed",
      "locator": {
        "by": "text",
        "exact": true,
        "value": "Completed"
      },
      "required": true,
      "type": "click"
    },
    {
      "at_seconds": 9,
      "expected_outcome": "success",
      "expected_result": "only active items are shown",
      "id": "show-active",
      "locator": {
        "by": "text",
        "exact": true,
        "value": "Active"
      },
      "required": true,
      "type": "click"
    }
  ],
