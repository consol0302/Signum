{
  "actions": [
    {
      "at_seconds": 1,
      "expected_outcome": "failure",
      "expected_result": "the disabled input remains unchanged",
      "id": "fill-disabled-input",
      "locator": {
        "by": "css",
        "value": "#input-example input"
      },
      "required": false,
      "timeout_ms": 600,
      "type": "fill",
      "value": "rejected"
    },
    {
      "at_seconds": 2.5,
      "expected_outcome": "success",
      "expected_result": "the input becomes enabled after loading",
      "id": "enable-input",
      "locator": {
        "by": "role",
        "exact": true,
        "name": "Enable",
        "role": "button"
      },
      "required": true,
      "type": "click"
    },
    {
      "at_seconds": 2.6,
      "expected_outcome": "success",
      "expected_result": "the enabled input is visible",
      "id": "wait-input-enabled",
      "locator": {
        "by": "css",
        "value": "#input-example input:enabled"
      },
      "required": true,
      "state": "visible",
      "timeout_ms": 4000,
      "type": "wait_for"
    },
    {
      "at_seconds": 6,
      "expected_outcome": "success",
      "expected_result": "the input contains enabled value",
      "id": "fill-enabled-input",
      "locator": {
        "by": "css",
        "value": "#input-example input"
      },
      "required": true,
      "type": "fill",
      "value": "enabled value"
    },
    {
      "at_seconds": 8,
      "expected_outcome": "success",
      "expected_result": "the input becomes disabled again",
      "id": "disable-input",
      "locator": {
        "by": "role",
        "exact": true,
        "name": "Disable",
        "role": "button"
      },
      "required": true,
      "type": "click"
    }
  ],
  "capture_policy": {
    "height": 720,
    "maximum_gap_seconds": 0.25,
    "minimum_average_fps": 10,
    "requested_fps": 15,
    "width": 1280
  },
  "case_id": "workflow-02-dynamic-controls-enable",
  "duration_seconds": 12,
  "goal": "Enable the text field, enter a short value, and verify enabled and disabled behavior.",
  "schema_version": 1,
