{
  "actions": [
    {
      "at_seconds": 1,
      "expected_outcome": "success",
      "expected_result": "the checkbox is removed after loading",
      "id": "remove-checkbox",
      "locator": {
        "by": "role",
        "exact": true,
        "name": "Remove",
        "role": "button"
      },
      "required": true,
      "type": "click"
    },
    {
      "at_seconds": 1.1,
      "expected_outcome": "success",
      "expected_result": "the checkbox is absent",
      "id": "wait-checkbox-removed",
      "locator": {
        "by": "css",
        "value": "#checkbox"
      },
      "required": true,
      "state": "hidden",
      "timeout_ms": 4000,
      "type": "wait_for"
    },
    {
      "at_seconds": 4.5,
      "expected_outcome": "failure",
      "expected_result": "the absent checkbox cannot be clicked",
      "id": "click-absent-checkbox",
      "locator": {
        "by": "css",
        "value": "#checkbox"
      },
      "required": false,
      "timeout_ms": 600,
      "type": "click"
    },
    {
      "at_seconds": 6,
      "expected_outcome": "success",
      "expected_result": "the checkbox is restored after loading",
      "id": "add-checkbox",
      "locator": {
        "by": "role",
        "exact": true,
        "name": "Add",
        "role": "button"
      },
      "required": true,
      "type": "click"
    },
    {
      "at_seconds": 6.1,
      "expected_outcome": "success",
      "expected_result": "the checkbox is visible again",
      "id": "wait-checkbox-restored",
      "locator": {
        "by": "css",
        "value": "#checkbox"
      },
      "required": true,
      "state": "visible",
      "timeout_ms": 4000,
      "type": "wait_for"
    }
  ],
  "capture_policy": {
