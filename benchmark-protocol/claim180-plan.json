    "workflow-27-w3-tabs",
    "workflow-28-w3-snackbar",
    "workflow-29-w3-accordion",
    "workflow-30-w3-filter-list"
  ],
  "category_targets": {
    "small_ui": 30,
    "action_success": 24,
    "action_failure": 24,
    "popup_notification": 18,
    "loading_completion": 18,
    "scroll_navigation": 15,
    "cursor_hover_focus": 15,
    "animation_game_hud": 18,
    "transient_event": 18
  },
  "evidence_policy": {
    "scope": "computer-use perception only; no action-execution score",
    "capture": {
      "viewport": "1280x720",
      "format": "original timestamped browser recording",
      "minimum_frame_rate": 10,
      "fixed_duration_state_reconstruction": false
    },
    "labels": {
      "created_before_any_model_run": true,
      "labels_hidden_from_models": true,
      "unique_source_transition_per_eligible_event": true,
      "constructed_failures_eligible": false,
      "ambiguous_or_corrupted_events_retained_as_ineligible": true
    },
    "event_checkpoint_native_replay": {
      "passive_event": "original frame at the frozen event midpoint",
      "action_event": "original frames at frozen before and after timestamps",
      "allowed_requests": [
        "screenshot",
        "zoom_when_documented_by_provider"
      ],
      "disallowed_requests": [
        "click",
        "type",
        "scroll",
        "navigate",
        "wait"
      ],
      "provider_failures_count_as_failures": true
    },
    "review": "two independent human-blind reviewers plus adjudication"
  },
  "observation_budget": {
    "unit": "per eligible event",
    "max_turns": 6,
    "max_screenshots": 3,
    "max_zooms": 2,
    "same_frozen_prompt_and_output_schema": true,
    "all_requests_count_toward_cost_and_latency": true
  },
  "workflow_sources": [
    {
      "case_id": "workflow-01-dynamic-controls-remove",
      "url": "https://the-internet.herokuapp.com/dynamic_controls",
      "goal": "Remove the checkbox, observe the loading state, and verify the replacement state."
    },
    {
      "case_id": "workflow-02-dynamic-controls-enable",
      "url": "https://the-internet.herokuapp.com/dynamic_controls",
      "goal": "Enable the text field, enter a short value, and verify enabled and disabled behavior."
    },
    {
      "case_id": "workflow-03-dynamic-loading-hidden",
      "url": "https://the-internet.herokuapp.com/dynamic_loading/1",
      "goal": "Start the hidden-element example and detect the completed Hello World state."
    },
    {
      "case_id": "workflow-04-dynamic-loading-rendered",
      "url": "https://the-internet.herokuapp.com/dynamic_loading/2",
      "goal": "Start the rendered-element example and detect its loading and completion states."
    },
    {
      "case_id": "workflow-05-add-remove-elements",
      "url": "https://the-internet.herokuapp.com/add_remove_elements/",
      "goal": "Add and remove controls while verifying both successful and unchanged outcomes."
    },
    {
      "case_id": "workflow-06-notification-message",
      "url": "https://the-internet.herokuapp.com/notification_message_rendered",
      "goal": "Request a notification and identify the visible status message."
    },
    {
      "case_id": "workflow-07-auth-success",
      "url": "https://the-internet.herokuapp.com/login",
      "goal": "Sign in with the documented test account and verify the secure-area state."
    },
    {
      "case_id": "workflow-08-auth-rejected",
