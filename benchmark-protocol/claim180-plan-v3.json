  "evidence_policy": {
    "capture": {
      "fixed_duration_state_reconstruction": false,
      "format": "original timestamped browser recording",
      "minimum_frame_rate": 10,
      "viewport": "1280x720"
    },
    "event_checkpoint_native_replay": {
      "action_event": "original frames at frozen before and after timestamps",
      "allowed_requests": [
        "screenshot",
        "zoom_when_documented_by_provider"
      ],
      "disallowed_requests": [
        "click",
        "type",
        "scroll",
        "navigate",
        "wait"
      ],
      "passive_event": "original frame at the frozen event midpoint",
      "provider_failures_count_as_failures": true
    },
    "labels": {
      "ambiguous_or_corrupted_events_retained_as_ineligible": true,
      "constructed_failures_eligible": false,
      "created_before_any_model_run": true,
      "labels_hidden_from_models": true,
      "unique_source_transition_per_eligible_event": true
    },
    "review": "two independent human-blind reviewers plus adjudication",
    "scope": "computer-use perception only; no action-execution score"
  },
